@startuml
autonumber

actor Usuario as user
participant "Menu" as menu
participant "Operaciones" as operaciones

user -> menu: Seleccionar "Añadir Televisor"
menu -> user: Solicitar datos del televisor
user --> menu: Ingresar datos (precio, marca, nombre, tipo de pantalla, tamaño)

menu -> operaciones: Validar marca
operaciones --> menu: Marca válida

menu -> operaciones: Registrar televisor
operaciones --> menu: Televisor registrado

menu -> user: Confirmar registro exitoso
menu -> user: Mostrar mensaje de error (si ocurre)

@enduml